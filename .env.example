# ==============================================================================
# SuperBenchmark — Environment Variables Configuration Template
# ==============================================================================

# Configurazione LLM Judge & Local RAG
# I parametri predefiniti di valutazione sono gestiti in config.json,
# ma puoi opzionalmente definire chiavi API o endpoint personalizzati qui sotto.
# ------------------------------------------------------------------------------
# URL del server Ollama locale (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Endpoint del server RAG locale BM25 (default: http://127.0.0.1:8000/ask)
# LOCAL_RAG_ENDPOINT=http://127.0.0.1:8000/ask

# Se si desidera utilizzare un provider cloud (OpenAI / Azure / Groq) come giudice:
# OPENAI_API_KEY=your_openai_api_key_here
