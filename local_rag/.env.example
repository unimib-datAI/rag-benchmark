# OpenAI-compatible chat endpoint that generates the answers (e.g. Azure AI Foundry)
LLM_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1/
LLM_API_KEY=
# on Azure this is the deployment name
LLM_MODEL=gpt-4o-mini
# leave empty for models that only accept the default temperature (e.g. GPT-6 Luna)
LLM_TEMPERATURE=0

# OpenAI-compatible embedding endpoint of the dense index (e.g. Azure AI Foundry), read by index.py and server.py
EMBEDDING_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1/
EMBEDDING_API_KEY=
# on Azure this is the deployment name
EMBEDDING_MODEL=text-embedding-3-large
